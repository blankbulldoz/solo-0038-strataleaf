{
  "language": "Python",
  "project_shape": "backend",
  "source_extensions": [
    ".py"
  ],
  "build_command": "python3 -m compileall -q strataleaf examples deploy",
  "testing": "deferred",
  "python_requires": ">=3.11",
  "workflow_checks": [
    {
      "workflow_id": "catalog",
      "command": "python3 -m examples.workflows catalog"
    },
    {
      "workflow_id": "schema",
      "command": "python3 -m examples.workflows schema"
    },
    {
      "workflow_id": "commit",
      "command": "python3 -m examples.workflows commit"
    },
    {
      "workflow_id": "snapshot",
      "command": "python3 -m examples.workflows snapshot"
    },
    {
      "workflow_id": "query",
      "command": "python3 -m examples.workflows query"
    },
    {
      "workflow_id": "index",
      "command": "python3 -m examples.workflows index"
    },
    {
      "workflow_id": "feed",
      "command": "python3 -m examples.workflows feed"
    },
    {
      "workflow_id": "backup",
      "command": "python3 -m examples.workflows backup"
    },
    {
      "workflow_id": "replica",
      "command": "python3 -m examples.workflows replica"
    },
    {
      "workflow_id": "compact",
      "command": "python3 -m examples.workflows compact"
    },
    {
      "workflow_id": "expire",
      "command": "python3 -m examples.workflows expire"
    },
    {
      "workflow_id": "aggregate",
      "command": "python3 -m examples.workflows aggregate"
    },
    {
      "workflow_id": "patch",
      "command": "python3 -m examples.workflows patch"
    },
    {
      "workflow_id": "inspect",
      "command": "python3 -m examples.workflows inspect"
    },
    {
      "workflow_id": "transfer",
      "command": "python3 -m examples.workflows transfer"
    }
  ],
  "operational_checks": [
    {
      "check_id": "container-preflight",
      "command": "python3 deploy/container/strataleaf_ops.py --config deploy/container/service.conf preflight",
      "note": "requires a persistent local data/state volume"
    },
    {
      "check_id": "container-drills",
      "command": "STRATALEAF_DRILL_ALLOW_PSEUDO=1 python3 deploy/container/strataleaf_ops.py --config deploy/container/service.conf drill --workspace /tmp/strataleaf-drill --mode all",
      "note": "set STRATALEAF_ALLOW_FUSE=1 on Docker Desktop/OrbStack local bind mounts; omit the pseudo waiver on a real persistent volume"
    }
  ]
}
